diff --git a/crates/llmbase-core/src/compat_io.rs b/crates/llmbase-core/src/compat_io.rs
--- a/crates/llmbase-core/src/compat_io.rs
+++ b/crates/llmbase-core/src/compat_io.rs
@@ -50,6 +50,39 @@
         if !inside {
             return Err(Error::Scope);
         }
+        // Engine-owned and coordination artifacts are never valid destinations.
+        // The destination is compared after parent symlink resolution, so an
+        // alias into meta cannot bypass this. Replacing the database corrupts
+        // persistent state; renaming over the held writer lock swaps its inode
+        // and defeats flock coordination. The per-write spellings this module
+        // generates next to every destination — `.<name>.llmbase.lock` and
+        // `.llmbase-<id>.stage` — are reserved within configured roots, so a
+        // direct write can never replace a live lock or collide with a stage.
+        // Refusal happens before any session, directory, lock or stage is made.
+        let meta = resolve_path(&config.meta)?;
+        let name = name.to_string_lossy();
+        // ASCII case-insensitive comparison, applied uniformly on every
+        // platform: on case-insensitive filesystems `LLMBASE.SQLITE3` is the
+        // same inode as `llmbase.sqlite3`, so a case-sensitive rule lets a
+        // mixed-case alias replace the live database or writer lock. Folding
+        // case here reserves those aliases everywhere, including Linux CI.
+        let engine_owned = destination.parent() == Some(meta.as_path())
+            && [
+                "llmbase.sqlite3",
+                "llmbase.sqlite3-wal",
+                "llmbase.sqlite3-shm",
+                "llmbase.sqlite3-journal",
+                "llmbase.writer.lock",
+            ]
+            .iter()
+            .any(|reserved| name.eq_ignore_ascii_case(reserved));
+        let folded = name.to_ascii_lowercase();
+        if engine_owned
+            || (folded.starts_with('.') && folded.ends_with(".llmbase.lock"))
+            || (folded.starts_with(".llmbase-") && folded.ends_with(".stage"))
+        {
+            return Err(Error::Scope);
+        }
     }
     let _writer = config.map(WriterSession::acquire).transpose()?;
     let parent = destination.parent().unwrap();
