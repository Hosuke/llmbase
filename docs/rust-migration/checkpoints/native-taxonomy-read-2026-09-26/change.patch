+fn write_library(base: &Path, files: &Value) {
+    for (relative, data) in files.as_object().unwrap() {
+        let path = base.join(relative);
+        fs::create_dir_all(path.parent().unwrap()).unwrap();
+        fs::write(&path, data.as_str().unwrap()).unwrap();
+    }
